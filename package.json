{
  "name": "verdena-lt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "prisma db push && node scripts/sync-tournament-tables.mjs && next start",
    "db:sync-tables": "node scripts/sync-tournament-tables.mjs",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.0.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
